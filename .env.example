# caliban-ai/docker-compose — environment
# Copy to `.env` (gitignored) and edit:  cp .env.example .env
# `.env` is read automatically by `docker compose`.

# ─────────────────────────────────────────────────────────────────────────────
# Image versions (pinned)
# ─────────────────────────────────────────────────────────────────────────────
# Pin to published GHCR release tags. For reproducible deploys you may pin by
# digest instead, e.g. GONZALO_VERSION=0.7.0@sha256:...  (hardened option).
#
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  ⚠  THESE PINS ARE STALE AND THE STACK WILL NOT START AS SHIPPED.        ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# All three images are published on GHCR (the old "caliban is an upstream
# prerequisite, not published yet" note was wrong and has been removed). The
# problem is the versions:
#
#   var                 pinned   published latest   status
#   CALIBAN_VERSION     0.4.0    0.15.0            ✗ 0.4.0 WAS NEVER PUBLISHED
#                                                    (oldest caliban tag is 0.5.0)
#                                                    → `docker compose up` fails to pull
#   GONZALO_VERSION     0.2.0    0.7.0             stale by 5 minor releases
#   PROSPERO_VERSION    0.1.0    0.8.1             stale by 7 minor releases
#
# They were NOT bumped here because they move as a cohort and the revision needs
# a live test this docs pass could not run:
#
#   * prospero >= 0.8.0 is BREAKING for deployments: with no API tokens
#     configured, prosperod refuses a non-loopback --addr, and compose.yaml sets
#     PROSPERO_ADDR=0.0.0.0:7878. Bumping prospero therefore also needs either
#     PROSPERO_API_TOKENS_FILE (a tokens file, from
#     `prospero token new <name> --scope read|operate|admin`) or an explicit
#     PROSPERO_INSECURE_NO_AUTH=1.
#   * gonzalo 0.7.0 makes deletion replicate via tombstones and adds record
#     kinds a 0.2 binary cannot decode. Every binary reading or syncing the
#     gonzalo-data volume must be upgraded together, and an existing 0.2-era
#     volume is the risky case.
#   * prosperod and caliband share a control-plane wire contract that moved into
#     the caliban-contract crate in caliban 0.14.0. prospero 0.1.0 predates it by
#     seven releases, so bumping caliban alone would break the pairing — raising
#     one pin without the others is worse than leaving all three.
#
# The current published cohort, if you are revising this: caliban 0.15.0,
# gonzalo 0.7.0, prospero 0.8.1. For a maintained deployment today, prefer the
# Kubernetes charts at https://github.com/caliban-ai/helm-charts, whose CI proves
# that cohort comes up and reconciles a task.
CALIBAN_VERSION=0.4.0
GONZALO_VERSION=0.2.0
PROSPERO_VERSION=0.1.0

# ─────────────────────────────────────────────────────────────────────────────
# Model provider credentials (caliban)
# ─────────────────────────────────────────────────────────────────────────────
# Default provider: Anthropic. Supply your key here for the `.env` path.
# (For a hardened deployment, leave this blank and use the secrets overlay:
#  docker compose -f compose.yaml -f overlays/secrets.yaml up)
ANTHROPIC_API_KEY=

# Other providers are passed through if you set them (uncomment as needed):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# CALIBAN_LIVE_BEDROCK=1
# CALIBAN_LIVE_VERTEX=1
# GOOGLE_APPLICATION_CREDENTIALS=/run/gcp/creds.json

# ─────────────────────────────────────────────────────────────────────────────
# Base stack
# ─────────────────────────────────────────────────────────────────────────────
# Host port the prospero dashboard is published on.
PROSPERO_HTTP_PORT=7878

# prosperod's fleet IDENTITY (PROSPERO_HOST), not a backend selector. Optional —
# compose defaults it to `local`.
# PROSPERO_HOST=local

# Host directory caliban supervises, mounted into BOTH caliban and prospero at
# the same in-container path (/workspace) so socket discovery matches. Must be a
# real directory (no symlink surprises). Create it before `up`: mkdir -p workspace
CALIBAN_WORKSPACE=./workspace

# Log verbosity for all services.
RUST_LOG=info

# ─────────────────────────────────────────────────────────────────────────────
# postgres overlay  (overlays/postgres.yaml)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=prospero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prospero
# Replica identity for clustered prosperod. Optional — the overlay defaults it to
# `prospero-1`. Give each replica a distinct value if you run more than one.
# PROSPERO_REPLICA_ID=prospero-1

# ─────────────────────────────────────────────────────────────────────────────
# proxy overlay  (overlays/proxy.yaml)
# ─────────────────────────────────────────────────────────────────────────────
# Public hostname Caddy serves + auto-provisions certs for. Use a real DNS name
# in production; for local testing you can use e.g. prospero.localhost.
DOMAIN=prospero.localhost

# ─────────────────────────────────────────────────────────────────────────────
# network overlay  (overlays/network.yaml)
# ─────────────────────────────────────────────────────────────────────────────
# Shared bearer token prospero uses to authenticate to caliband over TCP+TLS.
# Generate a strong value, e.g.: openssl rand -hex 32
CALIBAN_DAEMON_TOKEN=
# Port caliband listens on for the TLS control plane (compose-internal).
CALIBAN_DAEMON_PORT=8443
