# caliban-ai/docker-compose — environment
# Copy to `.env` (gitignored) and edit:  cp .env.example .env
# `.env` is read automatically by `docker compose`.

# ─────────────────────────────────────────────────────────────────────────────
# Image versions (pinned)
# ─────────────────────────────────────────────────────────────────────────────
# Pin to published GHCR release tags. For reproducible deploys you may pin by
# digest instead, e.g. GONZALO_VERSION=0.7.0@sha256:...  (hardened option).
#
# The published cohort below is tested together. These three move AS A SET:
# prosperod and caliband share a control-plane wire contract (it moved into the
# caliban-contract crate in caliban 0.14.0), so raising one pin alone can break
# the pairing. When you bump, bump all three and run `scripts/preflight.sh`.
#
#   caliban 0.15.0 · gonzalo 0.7.0 · prospero 0.8.1
#
# Two things to know before changing them:
#
#   * prospero >= 0.8.0 authenticates its API. With no tokens configured it
#     refuses a non-loopback --addr, and this stack binds 0.0.0.0:7878. The base
#     compose therefore passes --api-tokens-file; generate the material once with
#     `scripts/gen-prospero-auth.sh`. To serve unauthenticated instead, stack
#     overlays/no-auth.yaml last.
#   * gonzalo >= 0.7.0 replicates deletion via tombstones and adds record kinds a
#     0.2-era binary cannot decode. A `gonzalo-data` volume written by gonzalo
#     < 0.7 is NOT supported: there is no in-place migration, so remove the
#     volume and start fresh (`docker compose down && docker volume rm
#     <project>_gonzalo-data`). Nothing is lost that this stack could have
#     written, since it could never boot on its old pins.
CALIBAN_VERSION=0.15.0
GONZALO_VERSION=0.7.0
PROSPERO_VERSION=0.8.1

# ─────────────────────────────────────────────────────────────────────────────
# Model provider credentials (caliban)
# ─────────────────────────────────────────────────────────────────────────────
# Default provider: Anthropic. Supply your key here for the `.env` path.
# (For a hardened deployment, leave this blank and use the secrets overlay:
#  docker compose -f compose.yaml -f overlays/secrets.yaml up)
ANTHROPIC_API_KEY=

# Other providers are passed through if you set them (uncomment as needed):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# CALIBAN_LIVE_BEDROCK=1
# CALIBAN_LIVE_VERTEX=1
# GOOGLE_APPLICATION_CREDENTIALS=/run/gcp/creds.json

# ─────────────────────────────────────────────────────────────────────────────
# Base stack
# ─────────────────────────────────────────────────────────────────────────────
# Host port the prospero dashboard is published on.
PROSPERO_HTTP_PORT=7878

# prosperod's fleet IDENTITY (PROSPERO_HOST), not a backend selector. Optional —
# compose defaults it to `local`.
# PROSPERO_HOST=local

# Host directory caliban supervises, mounted into BOTH caliban and prospero at
# the same in-container path (/workspace) so socket discovery matches. Must be a
# real directory (no symlink surprises). Create it before `up`: mkdir -p workspace
CALIBAN_WORKSPACE=./workspace

# Run every service as this user. All three images default to uid 10001 (`app`).
# Set these to your own `id -u` / `id -g` when agents must WRITE to the
# bind-mounted workspace above (git worktrees, file edits) — the one-shot `init`
# service chowns the named volumes to match before anything else starts.
# CALIBAN_UID=1000
# CALIBAN_GID=1000

# Log verbosity for all services.
RUST_LOG=info

# ─────────────────────────────────────────────────────────────────────────────
# prospero API auth
# ─────────────────────────────────────────────────────────────────────────────
# Token material lives in files under secrets/prospero/ (gitignored), not here:
#
#   scripts/gen-prospero-auth.sh              # one admin token + session key
#   scripts/gen-prospero-auth.sh ci read      # another, named `ci`, read-only
#
# Sign in to the dashboard with the printed token; scripts send it as
# `Authorization: Bearer pspo_...`. prosperod stores only a SHA-256 hash, so a
# lost token cannot be recovered — mint another and delete the old line.

# ─────────────────────────────────────────────────────────────────────────────
# postgres overlay  (overlays/postgres.yaml)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=prospero
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prospero
# Replica identity for clustered prosperod. Optional — the overlay defaults it to
# `prospero-1`. Give each replica a distinct value if you run more than one.
# PROSPERO_REPLICA_ID=prospero-1

# ─────────────────────────────────────────────────────────────────────────────
# proxy overlay  (overlays/proxy.yaml)
# ─────────────────────────────────────────────────────────────────────────────
# Public hostname Caddy serves + auto-provisions certs for. Use a real DNS name
# in production; for local testing you can use e.g. prospero.localhost.
DOMAIN=prospero.localhost

# ─────────────────────────────────────────────────────────────────────────────
# network overlay  (overlays/network.yaml)
# ─────────────────────────────────────────────────────────────────────────────
# Shared bearer token prospero uses to authenticate to caliband over TCP+TLS.
# Generate a strong value, e.g.: openssl rand -hex 32
CALIBAN_DAEMON_TOKEN=
# Port caliband listens on for the TLS control plane (compose-internal).
CALIBAN_DAEMON_PORT=8443
